# Django Core Settings
SECRET_KEY=django-insecure-your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.azurewebsites.net

# Azure AI Foundry Configuration
# Supports both Azure AI Agent endpoints and Azure OpenAI chat completions
AZURE_AI_ENDPOINT=https://<your-hub>.services.ai.azure.com/api/projects/<project-id>/agents/<agent-name>/endpoint/protocols/openai/responses
AZURE_AI_KEY=your_azure_ai_api_key_here
AZURE_AI_DEPLOYMENT_NAME=gpt-5
AZURE_AI_API_VERSION=v1

# Database (Leave blank to use SQLite by default; populate for Supabase PostgreSQL)
# Option 1: Supabase Connection Pooler (Recommended for cloud/serverless, Port 6543)
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Option 2: Supabase Direct Connection (Port 5432)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase API (Optional SDK client for Realtime, Auth, Storage)
# SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# SUPABASE_KEY=[YOUR-SUPABASE-ANON-OR-SERVICE-KEY]

